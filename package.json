{
  "name": "agency-ops-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && node -e \"const f=require('fs');f.mkdirSync('dist/.openai',{recursive:true});f.copyFileSync('.openai/hosting.json','dist/.openai/hosting.json')\"",
    "start": "vinext start",
    "typecheck": "tsc --noEmit",
    "test:capacity": "node --test shared/capacity/capacity.test.ts",
    "test:jarvis": "node --test worker/jarvis/guards.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "vinext": "1.0.0-beta.10"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.0",
    "@types/node": "22.13.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "typescript": "5.8.2",
    "vite": "8.2.1"
  }
}

{
  "name": "imobi-board",
  "private": true,
  "version": "0.1.0",
  "description": "Imobi-Board - CRM imobiliario que conecta anuncio, lead, corretor e venda.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @imobi-board/web dev",
    "dev:api": "pnpm --filter @imobi-board/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @imobi-board/web test",
    "db:push": "node scripts/db-push.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "deploy": "node scripts/deploy-staging.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}

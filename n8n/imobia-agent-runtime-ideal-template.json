      ],
      "parameters": {
        "jsCode": "const ctx=$json;\nconst c=ctx.conversation||{};\nconst last=[...(ctx.messages||[])].reverse().find(m=>m.direcao==='IN');\nconst text=(last?.conteudo||'').toLowerCase();\nconst manual=c.modo!=='IA'||c.status==='RESOLVIDA';\nconst optout=/\\b(n[aÃ£]o tenho interesse|pare de mandar|n[aÃ£]o quero mais|j[aÃ¡] resolvi|remova meu contato)\\b/i.test(text);\nconst human=/\\b(humano|atendente|corretor|boleto|contrato|vistoria|reparo|manuten[cÃ§][aÃ£]o|financeiro|pagamento|jur[iÃ­]dico)\\b/i.test(text);\nconst priority=optout?'CANCELAR_FOLLOWUP':human?'HANDOFF_IMEDIATO':'AGENTE';\nreturn [{json:{...ctx,macroState:manual?'MANUAL':(c.estado_maquina||'ATENDIMENTO'),priorityAction:priority,shouldRun:!manual}}];"
      }
    },

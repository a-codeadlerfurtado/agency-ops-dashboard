      "parameters": {
        "jsCode": "let text=String($json.output||'').trim();\ntext=text.replace(/\\*\\*/g,'').replace(/^[-â€¢]\\s+/gm,'').replace(/#{1,6}\\s*/g,'');\nconst forbidden=[/desconto de \\d+/i,/garanto.*financi/i,/aprova[cÃ§][aÃ£]o.*garant/i,/parecer jur[iÃ­]dico/i,/certeza de aprova[cÃ§][aÃ£]o/i];\nconst hit=forbidden.find(r=>r.test(text));\nif(hit){return [{json:{...$json,needsSafeHandoff:true,blockedReason:'policy_output',safeText:'Vou encaminhar isso para um especialista da equipe, que consegue te orientar com seguranÃ§a.'}}]};\nreturn [{json:{...$json,needsSafeHandoff:false,safeText:text.slice(0,8000)}}];"

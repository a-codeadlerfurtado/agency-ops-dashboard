        "jsCode": "const ctx=$json; const req=$('Webhook').item.json.body; const c=ctx.conversation||{}; const history=(ctx.messages||[]).slice(-24).map(m=>`${m.direcao==='IN'?'Cliente':'Atendente'}: ${m.conteudo||'['+m.tipo+']'}`).join('\\n'); const attempt=req.payload?.attemptIndex||1; const after=req.payload?.afterMinutes||0; const prompt=`VocÃª Ã© o motor de follow-up da ImoBia. Analise o histÃ³rico e decida se ainda faz sentido reengajar. Tentativa ${attempt}; janela de inatividade configurada ${after} minutos. Se a conversa estiver manual, resolvida, houver pedido de parar, desinteresse, assunto encerrado ou qualquer sinal de que nÃ£o deve insistir, responda EXATAMENTE __SKIP__. Caso contrÃ¡rio escreva somente a mensagem a ser enviada: portuguÃªs do Brasil, humana, curta, 1 ou 2 frases, no mÃ¡ximo uma pergunta, retomando o contexto real. NÃ£o invente imÃ³vel, desconto, urgÃªncia, condiÃ§Ã£o, financiamento ou informaÃ§Ã£o. NÃ£o use markdown. NÃ£o diga que Ã© automaÃ§Ã£o. HistÃ³rico:\\n${history}`; return [{json:{...ctx,systemPrompt:prompt,userMessage:'Decida e gere o prÃ³ximo follow-up agora.'}}];"

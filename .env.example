# Imobi-Board - nomes de variaveis. NUNCA commitar valores reais (spec §104).
# Local: copie para .env (raiz) e .dev.vars (workers/api). Ambos estao no .gitignore.

# ---------- Supabase ----------
# Projeto: imobi-pro (schema dedicado imobi_board). Ver docs/supabase.md
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-side apenas. NUNCA expor ao frontend (spec §61).
SUPABASE_SERVICE_ROLE_KEY=

# Usado somente pelos scripts de migration/seed rodando na sua maquina.
SUPABASE_DB_URL=

# ---------- Frontend (Vite) ----------
# Somente VITE_* chega ao browser. Nao adicionar service role aqui.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------- Cloudflare ----------
CLOUDFLARE_ACCOUNT_ID=

# ---------- Ingestao ----------
# Segredo do endpoint generico de ingestao. Rotacionavel.
INGEST_SIGNING_SECRET=

# ---------- Meta Lead Ads (§53) ----------
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

# ---------- Agency bridge (§55) - contrato apenas, nao conectado ----------
AGENCY_BRIDGE_TOKEN=

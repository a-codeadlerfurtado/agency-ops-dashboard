NODE_ENV=production
PORT=3001
DATABASE_URL=postgresql://imobi_app:CHANGE_ME@postgres:5432/imobi
REDIS_URL=redis://redis:6379

# Meta
META_APP_ID=
META_APP_SECRET=
META_BROKER_URL=
META_BROKER_TOKEN=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v26.0
META_EMBEDDED_SIGNUP_CONFIG_ID=
# v4: mantenha vazio, salvo se a configuracao da Meta exigir algo especifico.
META_EMBEDDED_SIGNUP_EXTRAS_JSON={}

# 32 bytes em base64. Ex.: openssl rand -base64 32
APP_ENCRYPTION_KEY_B64=

# Opcional: worker/n8n consome o job depois do commit
N8N_AGENT_WEBHOOK=http://n8n:5678/webhook/whatsapp-agent
N8N_FOLLOWUP_WEBHOOK=http://n8n:5678/webhook/whatsapp-agent
INTERNAL_AGENT_TOKEN=CHANGE_ME_32_CHARS_MIN

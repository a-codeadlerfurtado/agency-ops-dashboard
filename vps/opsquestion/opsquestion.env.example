# Copie para /etc/opsquestion.env na VPS, preencha, e trave o arquivo:
#   sudo install -m 600 -o root -g root opsquestion.env.example /etc/opsquestion.env
#   sudo nano /etc/opsquestion.env
#
# Este arquivo de exemplo NAO deve receber valor nenhum: ele esta versionado.

# A chave do provedor de IA. Basta UMA.
#
# OpenAI e' o padrao, porque e' o que o cenario do Make ja' usava (conexao
# "open ai leonardo") - assim a mudanca e' de trajeto, nao de fatura.
# Use a MESMA chave que voce configurou no Make. Se nao tiver o valor guardado,
# nao ha' como recuperar: a OpenAI so' mostra a chave no momento em que ela e'
# criada, e o Make nao devolve o segredo de uma conexao. Nesse caso, gere uma
# chave nova em platform.openai.com - a antiga pode continuar viva no Make.
OPENAI_API_KEY=

# Alternativa. Se preencher esta em vez da de cima, o servico sobe na Anthropic
# sozinho. Com as duas preenchidas, quem decide e' AI_PROVIDER.
ANTHROPIC_API_KEY=

# O mesmo segredo que ja' vive em agency_ops.automation_settings na chave
# AI_ASK_READ_SECRET. Ele faz dois trabalhos: valida quem chama este servico
# (header x-ai-read-secret) e autentica este servico no executor de SQL
# (header x-ai-ask-secret). Pegue o valor com:
#   select value #>> '{}' from agency_ops.automation_settings where key='AI_ASK_READ_SECRET';
AI_ASK_READ_SECRET=

# Opcionais — os padroes do server.mjs servem.
# AI_PROVIDER=openai        # openai | anthropic (so' precisa com as duas chaves)
# OPENAI_MODEL=gpt-4o       # use o mesmo modelo do cenario do Make
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_BASE_URL=          # proxy ou Azure OpenAI
# PORT=8787
# HOST=127.0.0.1
# OPSQUESTION_MODEL=claude-sonnet-5
# DEADLINE_MS=45000
# MAX_STEPS=8
# SQL_ENDPOINT_URL=https://bfzdetibfcwihfkltbkp.supabase.co/functions/v1/agency-ops-run-readonly-sql

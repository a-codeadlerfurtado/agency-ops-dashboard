{
  "manifest_version": 3,
  "name": "Leonardo Meetings",
  "version": "0.1.0",
  "description": "Captura automática e local de reuniões do Google Meet para o Leonardo Imobi.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://bfzdetibfcwihfkltbkp.supabase.co/functions/v1/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Leonardo Meetings",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
